{
  "name": "@kannaka/steward",
  "version": "0.1.0",
  "description": "The Steward — a surface-agnostic Intent & Reliability Kernel for faithful agent action. Conscience before wallet: reads, reasons, dry-runs, and emits a human-signable package. Structurally incapable of executing, signing, or spending.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "steward": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "charters",
    "fixtures",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kannaka-labs/kannaka-steward.git"
  },
  "homepage": "https://github.com/kannaka-labs/kannaka-steward#readme",
  "keywords": [
    "agent",
    "governance",
    "intent",
    "dry-run",
    "safety",
    "dao"
  ],
  "author": "Nick Flach <nflach78@gmail.com>",
  "scripts": {
    "build": "tsc",
    "govern": "node --loader ts-node/esm src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
